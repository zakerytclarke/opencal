{
  "name": "opencal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "db": "python3 scripts/build-food-db.py",
    "db:label": "python3 scripts/build-food-db.py --label-only",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "tsx scripts/verify-vlm-parse.ts && tsx scripts/verify-food-search.ts && tsx scripts/verify-portions.ts && tsx scripts/verify-dates.ts && tsx scripts/verify-plan.ts && tsx scripts/verify-eval-metrics.ts",
    "test:parse": "tsx scripts/verify-vlm-parse.ts",
    "test:search": "tsx scripts/verify-food-search.ts",
    "ci": "npm test && tsc -b --pretty false && vite build",
    "test:vlm": "tsx scripts/vlm-smoke.ts",
    "eval": "tsx scripts/eval/run.ts --split test --modality both",
    "eval:text": "tsx scripts/eval/run.ts --split test --modality text",
    "eval:images": "tsx scripts/eval/run.ts --split test --modality images",
    "eval:train": "tsx scripts/eval/run.ts --split train --modality both",
    "eval:prepare": "tsx scripts/eval/prepare-foodd.ts",
    "eval:prepare-n5k": "tsx scripts/eval/prepare-n5k.ts",
    "ft:prepare": "/home/zclarke/ml_env/bin/python scripts/finetune/prepare.py",
    "ft:train": "/home/zclarke/ml_env/bin/python scripts/finetune/train.py",
    "ft:infer": "/home/zclarke/ml_env/bin/python scripts/finetune/infer.py",
    "ft:score": "tsx scripts/eval/score-extracts.ts",
    "ft:compare": "/home/zclarke/ml_env/bin/python scripts/finetune/compare.py",
    "ft:export": "/home/zclarke/ml_env/bin/python scripts/finetune/export.py --skip-onnx",
    "ft:serve": "/home/zclarke/ml_env/bin/python scripts/finetune/serve.py",
    "ft:run": "bash scripts/finetune/run.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.55.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
