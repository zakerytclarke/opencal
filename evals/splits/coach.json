{
  "seed": "opencal-coach-v1",
  "note": "Held-out coach eval. Never mix these user strings into fine-tune train JSONL. Gold kcal is USDA via foods.json.",
  "test": [
    {
      "id": "coach-chat-hey",
      "user": "hey what's up",
      "expect": "prose",
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-chat-thanks",
      "user": "ok thanks that's helpful",
      "expect": "prose",
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-kcal-banana",
      "user": "how many calories is a typical medium banana?",
      "expect": "prose",
      "must": ["kcal"],
      "kcalGold": [90, 130],
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-protein-yogurt",
      "user": "protein in a serving of plain greek yogurt?",
      "expect": "prose",
      "must": ["protein"],
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-invent",
      "user": "just guess the calories for mystery leftover soup",
      "expect": "prose",
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-log-oatmeal",
      "user": "please log half a cup of cooked oatmeal",
      "expect": "json",
      "foods": [{ "name": "oatmeal", "quantity": 0.5, "unit": "cup" }]
    },
    {
      "id": "coach-log-kind",
      "user": "add a KIND bar to my diary",
      "expect": "json",
      "foods": [{ "name": "kind", "quantity": 1, "unit": "bar" }]
    },
    {
      "id": "coach-log-turkey",
      "user": "log three slices of turkey bacon",
      "expect": "json",
      "foods": [{ "name": "turkey bacon", "quantity": 3, "unit": "slice" }]
    },
    {
      "id": "coach-fit-latte",
      "user": "does a grande latte fit in a 300 calorie drink budget?",
      "expect": "prose",
      "must": ["kcal"],
      "mustNot": ["{\"foods\":"]
    },
    {
      "id": "coach-what-can",
      "user": "what do you help with?",
      "expect": "prose",
      "mustNot": ["{\"foods\":"]
    }
  ]
}
